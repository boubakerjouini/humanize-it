# ===========================================
# HumanizeIt — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# --- Anthropic Claude (Rewrite engine) ---
ANTHROPIC_API_KEY=           # Clé Anthropic Claude (remplace OPENAI_API_KEY)

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=                # Neon PostgreSQL connection string
NEON_API_KEY=                # Neon API key (optionnel)

# --- Clerk (Auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- Stripe (Payments) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=         # price_1T5cfmRqj3f8LS1zuInYnr33
STRIPE_TEAM_PRICE_ID=        # price_1T5ciDRqj3f8LS1zM8ndCIEJ

# --- App ---
NEXT_PUBLIC_APP_URL=
