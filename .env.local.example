# ── Clerk Auth ──────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ── Database (Neon PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://...

# ── Polar (payments, merchant of record) ────────────────────
# Organization access token → Polar dashboard → Settings → Developers
POLAR_ACCESS_TOKEN=polar_oat_...
# Webhook secret → Settings → Webhooks → the /api/webhooks/polar endpoint
POLAR_WEBHOOK_SECRET=whsec_...
# Optional: "sandbox" for sandbox.polar.sh (needs a sandbox token and sandbox product ids)
POLAR_SERVER=

# Product IDs → Products → your product → copy the ID (a UUID)
POLAR_PRO_PRODUCT_ID=
POLAR_TEAM_PRODUCT_ID=
# Optional — annual products (a Polar product has one billing interval)
POLAR_PRO_ANNUAL_PRODUCT_ID=
POLAR_TEAM_ANNUAL_PRODUCT_ID=

# ── Anthropic (Claude) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://humanizeit.app
# Comma-separated admin emails (the founder is always an admin).
ADMIN_EMAILS=

# ── Growth engine: email (Resend) ───────────────────────────
# Set real values in Vercel → Project → Environment Variables (Production).
# Kill switch: nothing is emailed unless this is exactly "true", and only
# Vercel production can email non-allowlisted addresses.
EMAIL_SENDING_ENABLED=
# Comma-separated; while set, only these addresses (plus admins) get email.
EMAIL_ALLOWLIST=
# Provisioned by the Resend integration (confirm the exact name in Vercel).
RESEND_API_KEY=
# Signing secret of the Resend webhook (/api/webhooks/resend).
RESEND_WEBHOOK_SECRET=
# Sender for transactional and lifecycle email, e.g. HumanizeIt <hello@mail.humanizeit.app>
EMAIL_FROM=
# Optional marketing sender (defaults to EMAIL_FROM).
EMAIL_FROM_MARKETING=
# Optional sender for the founder's 1:1 notes (defaults to EMAIL_FROM).
EMAIL_FROM_PERSONAL=
# A monitored inbox for replies.
EMAIL_REPLY_TO=
# At least 32 random bytes; signs unsubscribe, preference and confirm links.
EMAIL_TOKEN_SECRET=
# Optional: the previous secret during a rotation, so old links keep working.
EMAIL_TOKEN_SECRET_PREVIOUS=
# Business address or PO box for footers; marketing email is skipped without it.
COMPANY_POSTAL_ADDRESS=
# Optional daily send cap (default 90, under Resend's free 100/day).
EMAIL_DAILY_CAP=

# ── Growth engine: jobs and programs ────────────────────────
# At least 16 random characters; Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# Optional: SHA-256 (hex) of the founder's agent token; turns on /api/agent/* (inbox, replies,
# test-first personal emails, report). The token itself stays in the founder's git-ignored
# .env.agent.local (HUMANIZEIT_AGENT_TOKEN), read by scripts/agent-mcp.mjs. Unset = API off (404).
AGENT_API_TOKEN_SHA256=
# Optional: "true" turns on the referral program (default off).
REFERRALS_ENABLED=
# Optional: 7-day Pro passes the sequences may issue per 30 days (default 20).
TRIAL_PASSES_PER_MONTH=
# Optional: Rule-of-100 daily outreach goal (default 30).
OUTREACH_DAILY_GOAL=

# ── Offers: one-time Polar products ─────────────────────────
# Unsetting one takes it off sale; orders already sold are still fulfilled
# and refunded (the webhook reads the offer from the order).
# Optional: Founding 100 product; unset shows a waitlist instead of checkout.
POLAR_FOUNDING_PRODUCT_ID=
# Optional: word pack product; unset hides the word pack everywhere.
POLAR_WORDPACK_PRODUCT_ID=
# Optional word pack size and validity in days (defaults 20000 and 60).
WORDPACK_WORDS=
WORDPACK_DAYS=

# Optional: where mail to @humanizeit.app is forwarded (comma-separated). Defaults to the founder.
INBOUND_FORWARD_TO=
# Optional sender of those forwards, on a verified sending domain.
# Defaults to HumanizeIt Inbox <inbox@EMAIL_FROM's domain>.
INBOUND_FORWARD_FROM=

# Support inbox sender check: the authserv-id (first token of the TOPMOST Authentication-Results)
# that Resend's receiving MX writes: amazonses.com (Resend receives through Amazon SES, eu-west-1;
# checked on a real message 2026-10-07). Re-check it in the raw source of a received email if
# receiving moves. Unset = SPF/DKIM/DMARC are reported as "not checked" and nothing is trusted.
INBOUND_AUTHSERV_ID=amazonses.com
