generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  TEAM
}

model User {
  id           String   @id @default(cuid())
  clerkId      String   @unique
  email        String   @unique
  name         String?
  plan         Plan     @default(FREE)
  wordsUsed    Int      @default(0)
  rewriteCount Int      @default(0)
  quotaResetAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents    Document[]
  subscription Subscription?
  redemptions  Redemption[]
}

model Document {
  id              String   @id @default(cuid())
  userId          String
  title           String?
  originalText    String
  analysisResult  Json
  overallScore    Float
  rewrittenText   String?
  rewriteModel    String?
  tone            String?
  humanizedScore  Float?
  wordCount       Int
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  // Lemon Squeezy fields — @map keeps the existing DB column names (no migration needed)
  lsCustomerId      String    @unique  @map("stripeCustomerId")
  lsSubscriptionId  String?   @unique  @map("stripeSubscriptionId")
  lsVariantId       String?            @map("stripePriceId")
  lsCurrentPeriodEnd DateTime?         @map("stripeCurrentPeriodEnd")
  status            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiscountCode {
  id          String       @id @default(cuid())
  code        String       @unique
  plan        String       // "PRO" | "TEAM"
  maxUses     Int          @default(1)
  usedCount   Int          @default(0)
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  redemptions Redemption[]
}

model Redemption {
  id             String       @id @default(cuid())
  userId         String
  discountCodeId String
  redeemedAt     DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id])

  @@unique([userId, discountCodeId])
}
