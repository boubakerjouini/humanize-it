generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  TEAM
}

model User {
  id           String   @id @default(cuid())
  clerkId      String   @unique
  email        String   @unique
  name         String?
  plan         Plan      @default(FREE)
  /** When a non-FREE plan granted via redeem code expires; null = no expiry (paid subscription or lifetime). */
  planExpiresAt DateTime?
  wordsUsed    Int       @default(0)
  rewriteCount Int       @default(0)
  quotaResetAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  documents    Document[]
  subscription Subscription?
  redemptions  Redemption[]
  apiKeys      ApiKey[]
}

model ApiKey {
  id                  String    @id @default(cuid())
  userId              String
  name                String    @default("Default")
  keyHash             String?   @unique
  keyPrefix           String    @default("")
  monthlyRequestCount Int       @default(0)
  monthlyResetAt      DateTime  @default(now())
  lastUsedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id              String   @id @default(cuid())
  userId          String
  title           String?
  originalText    String
  analysisResult  Json
  overallScore    Float
  rewrittenText   String?
  rewriteModel    String?
  tone            String?
  humanizedScore  Float?
  wordCount       Int
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  // Lemon Squeezy fields — @map keeps the existing DB column names (no migration needed)
  lsCustomerId      String    @unique  @map("stripeCustomerId")
  lsSubscriptionId  String?   @unique  @map("stripeSubscriptionId")
  lsVariantId       String?            @map("stripePriceId")
  lsCurrentPeriodEnd DateTime?         @map("stripeCurrentPeriodEnd")
  status            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiscountCode {
  id          String       @id @default(cuid())
  code        String       @unique
  plan        String       // "PRO" | "TEAM"
  maxUses     Int          @default(1)
  usedCount   Int          @default(0)
  /** Days the granted plan stays active after redemption; null = lifetime. */
  grantDays   Int?         @default(365)
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  redemptions Redemption[]
}

/// Fixed-window rate limiter counters (one row per key + minute window).
model RateLimit {
  id       String   @id @default(cuid())
  key      String
  windowAt DateTime
  count    Int      @default(0)

  @@unique([key, windowAt])
  @@index([windowAt])
}

/// Idempotency ledger for processed billing webhooks (prevents replay/double-apply).
model WebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  source    String   @default("lemonsqueezy")
  createdAt DateTime @default(now())
}

model Redemption {
  id             String       @id @default(cuid())
  userId         String
  discountCodeId String
  redeemedAt     DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id])

  @@unique([userId, discountCodeId])
}
